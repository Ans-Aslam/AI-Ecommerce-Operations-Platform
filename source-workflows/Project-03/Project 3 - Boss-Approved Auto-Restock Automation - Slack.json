        "jsonBody": "={{\n{\n  \"trigger_id\": $('Parse Slack Approval').item.json.triggerId,\n  \"view\": {\n    \"type\": \"modal\",\n    \"callback_id\": \"restock_quantity_modal\",\n    \"title\": {\n      \"type\": \"plain_text\",\n      \"text\": \"Restock Inventory\"\n    },\n    \"submit\": {\n      \"type\": \"plain_text\",\n      \"text\": \"Approve Restock\"\n    },\n    \"close\": {\n      \"type\": \"plain_text\",\n      \"text\": \"Cancel\"\n    },\n    \"private_metadata\": JSON.stringify({\n      \"product\": $json.product,\n      \"inventoryItemId\": $json.inventoryItemId,\n      \"locationId\": $json.locationId,\n      \"currentStock\": $json.currentStock\n    }),\n    \"blocks\": [\n      {\n        \"type\": \"section\",\n        \"text\": {\n          \"type\": \"mrkdwn\",\n          \"text\": \"*Product:* \" + $json.product + \"\\n*Current Stock:* \" + $json.currentStock\n        }\n      },\n      {\n        \"type\": \"input\",\n        \"block_id\": \"restock_quantity_block\",\n        \"label\": {\n          \"type\": \"plain_text\",\n          \"text\": \"Restock Quantity\"\n        },\n        \"element\": {\n          \"type\": \"plain_text_input\",\n          \"action_id\": \"restock_quantity\",\n          \"placeholder\": {\n            \"type\": \"plain_text\",\n            \"text\": \"Enter quantity, e.g. 20\"\n          }\n        }\n      }\n    ]\n  }\n}\n}}",
