    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  let phone = item.json.phone;\n  const countryCode = item.json.country_code || 'PK';\n\n  // Missing phone\n  if (\n    phone === null ||\n    phone === undefined ||\n    String(phone).trim() === '' ||\n    String(phone).toLowerCase() === 'null'\n  ) {\n    item.json.phone = null;\n    return item;\n  }\n\n  phone = String(phone).trim();\n\n  // Keep only digits and preserve a leading +\n  const hasPlus = phone.startsWith('+');\n  let digits = phone.replace(/\\D/g, '');\n\n  // Country calling codes\n  const countryCallingCodes = {\n    PK: '92',\n    US: '1',\n    CA: '1',\n    GB: '44',\n    AE: '971',\n    SA: '966',\n    QA: '974',\n    KW: '965',\n    BH: '973',\n    OM: '968',\n    IN: '91',\n    BD: '880',\n    AU: '61',\n    DE: '49',\n    FR: '33',\n    IT: '39',\n    ES: '34',\n    TR: '90',\n    MY: '60',\n    SG: '65'\n  };\n\n  const countryCallingCode = countryCallingCodes[countryCode];\n\n  // Already international:\n  // +923001234567 → 923001234567\n  // 923001234567  → 923001234567\n  // +14155552671   → 14155552671\n  if (hasPlus || (countryCallingCode && digits.startsWith(countryCallingCode))) {\n    item.json.phone = digits;\n    return item;\n  }\n\n  // Local number starting with 0:\n  // 03001234567 + PK → 923001234567\n  if (digits.startsWith('0')) {\n    digits = digits.substring(1);\n  }\n\n  // Add the customer's country calling code\n  if (countryCallingCode) {\n    item.json.phone = countryCallingCode + digits;\n  } else {\n    // Cannot safely normalize an unknown country\n    item.json.phone = null;\n    item.json.phoneNormalizationError =\n      `Unknown country code: ${countryCode}`;\n  }\n\n  return item;\n});"
      },
