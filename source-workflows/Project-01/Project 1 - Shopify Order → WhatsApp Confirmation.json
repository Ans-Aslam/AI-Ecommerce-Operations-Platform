      "parameters": {
        "jsCode": "const body = $json.body;\n\n// Get the WhatsApp value object\nconst value = body?.entry?.[0]?.changes?.[0]?.value;\n\n// Check for message status update\nconst statusData = value?.statuses?.[0];\n\nif (statusData) {\n  return [\n    {\n      json: {\n        phoneNumber: statusData.recipient_id ?? null,\n        messageId: statusData.id ?? null,\n        messageText: null,\n        messageType: null,\n        status: statusData.status ?? null,\n        statusMessageId: statusData.id ?? null\n      }\n    }\n  ];\n}\n\n// Check for incoming WhatsApp message\nconst message = value?.messages?.[0];\n\nif (message) {\n  return [\n    {\n      json: {\n        phoneNumber: message.from ?? null,\n        messageId: message.id ?? null,\n        messageText: message.text?.body ?? null,\n        messageType: message.type ?? null,\n        status: null,\n        statusMessageId: null\n      }\n    }\n  ];\n}\n\n// Nothing recognized\nreturn [\n  {\n    json: {\n      phoneNumber: null,\n      messageId: null,\n      messageText: null,\n      messageType: null,\n      status: null,\n      statusMessageId: null\n    }\n  }\n];"
      },
