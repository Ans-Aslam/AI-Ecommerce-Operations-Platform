    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n  const data = item.json;\n\n  const availableStock = Number(data.available_stock) || 0;\n  const averageDailySales = Number(data.averageDailySales) || 0;\n\n  let daysOfInventory = null;\n  let inventoryStatus = 'NO SALES DATA';\n\n  if (availableStock === 0) {\n    inventoryStatus = 'OUT OF STOCK';\n    daysOfInventory = 0;\n  } else if (averageDailySales > 0) {\n    daysOfInventory = Number(\n      (availableStock / averageDailySales).toFixed(1)\n    );\n\n    if (daysOfInventory <= 3) {\n      inventoryStatus = 'CRITICAL';\n    } else if (daysOfInventory <= 7) {\n      inventoryStatus = 'LOW';\n    } else {\n      inventoryStatus = 'HEALTHY';\n    }\n  }\n\n  return {\n    json: {\n      ...data,\n      daysOfInventory,\n      inventoryStatus\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1600,
        624
      ],
      "id": "13d40683-6caa-4a42-a466-bf79e34d5b3d",
      "name": "Calculate Inventory Risk"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n  const data = item.json;\n\n  return {\n    json: {\n      productName: data.productName,\n      sku: data.sku || 'N/A',\n      variantId: data.variantId,\n\n      unitsSold7Days: data.unitsSold7Days,\n      averageDailySales: data.averageDailySales,\n\n      availableStock: data.available_stock,\n      committedStock: data.committed_stock,\n      incomingStock: data.incoming_stock,\n\n      daysOfInventory: data.daysOfInventory,\n      inventoryStatus: data.inventoryStatus\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1824,
        624
      ],
      "id": "85c9a588-9cc7-4462-9d1e-4be5d0dfb1fd",
      "name": "Prepare Inventory Report"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst totalProducts = items.length;\n\nconst criticalProducts = items.filter(\n  item => item.json.inventoryStatus === 'CRITICAL'\n).length;\n\nconst lowProducts = items.filter(\n  item => item.json.inventoryStatus === 'LOW'\n).length;\n\nconst healthyProducts = items.filter(\n  item => item.json.inventoryStatus === 'HEALTHY'\n).length;\n\nconst totalAvailableStock = items.reduce(\n  (sum, item) => sum + Number(item.json.availableStock || 0),\n  0\n);\n\nconst totalUnitsSold7Days = items.reduce(\n  (sum, item) => sum + Number(item.json.unitsSold7Days || 0),\n  0\n);\n\nconst averageDailySales = Number(\n  (totalUnitsSold7Days / 7).toFixed(2)\n);\n\nreturn [\n  {\n    json: {\n      reportDate: new Date().toISOString().split('T')[0],\n      totalProducts,\n      criticalProducts,\n      lowProducts,\n      healthyProducts,\n      totalAvailableStock,\n      totalUnitsSold7Days,\n      averageDailySales\n    }\n  }\n];"
      },
