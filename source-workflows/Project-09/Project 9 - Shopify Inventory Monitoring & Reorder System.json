    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\nconst report = `ðŸ“¦ *Daily Inventory Report*\nâ”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”\nðŸ“… Date: ${data.reportDate}\n\nðŸ“Š *Inventory Overview*\nâ€¢ Total Products: ${data.totalProducts}\nâ€¢ Healthy: ${data.healthyProducts}\nâ€¢ Low Stock: ${data.lowProducts}\nâ€¢ Critical: ${data.criticalProducts}\n\nðŸ“ˆ *Sales & Stock*\nâ€¢ Units Sold (7 Days): ${data.totalUnitsSold7Days}\nâ€¢ Average Daily Sales: ${data.averageDailySales}\nâ€¢ Available Stock: ${data.totalAvailableStock}\n\nâ”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”â”\nInventory monitoring completed successfully.`;\n\nreturn [\n  {\n    json: {\n      ...data,\n      report\n    }\n  }\n];"
      },
