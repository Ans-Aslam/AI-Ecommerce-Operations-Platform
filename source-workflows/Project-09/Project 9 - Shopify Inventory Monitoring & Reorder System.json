        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "query",
              "value": "={{ `query {\n  orders(\n    first: 100\n    query: \"created_at:>=${$json.sales_start_date} financial_status:paid\"\n    sortKey: CREATED_AT\n    reverse: true\n  ) {\n    edges {\n      node {\n        id\n        name\n        createdAt\n        displayFinancialStatus\n        lineItems(first: 50) {\n          edges {\n            node {\n              id\n              name\n              quantity\n              sku\n              variant {\n                id\n                title\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}` }}"
            }
          ]
        },
