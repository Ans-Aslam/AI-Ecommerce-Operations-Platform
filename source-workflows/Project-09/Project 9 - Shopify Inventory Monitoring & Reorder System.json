        "jsonBody": "{\n  \"query\": \"query { productVariants(first: 50) { edges { node { id title sku product { id title } inventoryItem { id tracked inventoryLevels(first: 10) { edges { node { location { id name } quantities(names: [\\\"available\\\", \\\"on_hand\\\", \\\"committed\\\", \\\"incoming\\\"]) { name quantity } } } } } } } } }\"\n}",
