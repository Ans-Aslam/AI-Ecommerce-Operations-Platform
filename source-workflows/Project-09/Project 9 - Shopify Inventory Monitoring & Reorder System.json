      "id": "8c52ea52-13b8-43cf-8eb1-f27380cdafb1",
      "name": "Get Shopify Sales History"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "eda6d045-9d6f-47ec-ada5-bbc3e0fc7d97",
              "name": "sales_start_date",
              "value": "={{ $now.minus({ days: 7 }).toFormat('yyyy-MM-dd') }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        16,
        384
      ],
      "id": "2180fa2f-2fa1-4df3-ac1f-48002a88e1f6",
      "name": "Prepare Sales Query"
    },
    {
      "parameters": {
        "jsCode": "const orders = $input.first().json.data.orders.edges;\n\nconst results = [];\n\nfor (const edge of orders) {\n  const order = edge.node;\n\n  for (const lineEdge of order.lineItems.edges) {\n    const item = lineEdge.node;\n\n    results.push({\n      orderId: order.id,\n      orderNumber: order.name,\n      orderDate: order.createdAt,\n      financialStatus: order.displayFinancialStatus,\n      productName: item.name,\n      quantity: item.quantity,\n      sku: item.sku || \"N/A\",\n      variantId: item.variant?.id || null,\n      variantTitle: item.variant?.title || \"N/A\"\n    });\n  }\n}\n\nreturn results.map(item => ({ json: item }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        496,
        384
      ],
      "id": "6b61914d-ea66-41c2-aad0-9b50a45fdf82",
      "name": "Prepare Sales Data"
    },
    {
      "parameters": {
        "jsCode": "const orders = $input.all();\n\nconst totalOrders = new Set(\n  orders.map(item => item.json.orderNumber)\n).size;\n\nconst totalUnitsSold = orders.reduce(\n  (sum, item) => sum + Number(item.json.quantity || 0),\n  0\n);\n\nconst productSales = {};\n\nfor (const item of orders) {\n  const product = item.json.productName;\n  const quantity = Number(item.json.quantity || 0);\n\n  if (!productSales[product]) {\n    productSales[product] = 0;\n  }\n\n  productSales[product] += quantity;\n}\n\nconst topProduct = Object.entries(productSales)\n  .sort((a, b) => b[1] - a[1])[0];\n\nreturn [\n  {\n    json: {\n      reportDate: new Date().toISOString().split('T')[0],\n      totalOrders,\n      totalUnitsSold,\n      topProduct: topProduct ? topProduct[0] : 'N/A',\n      topProductUnits: topProduct ? topProduct[1] : 0\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        944,
        384
      ],
      "id": "faf3d65a-2a60-4888-8c75-6444ff4c4690",
      "name": "Calculate Sales Metrics"
    },
    {
      "parameters": {
        "jsCode": "const sales = $input.all();\n\nconst products = {};\n\nfor (const item of sales) {\n  const data = item.json;\n\n  const variantId = data.variantId;\n  const productName = data.productName;\n  const sku = data.sku;\n  const quantity = Number(data.quantity || 0);\n\n  if (!variantId) {\n    continue;\n  }\n\n  if (!products[variantId]) {\n    products[variantId] = {\n      variantId,\n      productName,\n      sku,\n      unitsSold7Days: 0,\n      orderCount: 0\n    };\n  }\n\n  products[variantId].unitsSold7Days += quantity;\n  products[variantId].orderCount += 1;\n}\n\nreturn Object.values(products).map(product => ({\n  json: {\n    ...product,\n    averageDailySales: Number(\n      (product.unitsSold7Days / 7).toFixed(2)\n    )\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
