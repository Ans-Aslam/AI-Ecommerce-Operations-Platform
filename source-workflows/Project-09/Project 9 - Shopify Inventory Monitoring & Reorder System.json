      "id": "164881fd-070e-4eba-9f7a-154cbdbbb91d",
      "name": "Get Shopify Inventory"
    },
    {
      "parameters": {
        "jsCode": "const variants = $input.first().json.data.productVariants.edges;\n\nconst results = [];\n\nfor (const edge of variants) {\n  const variant = edge.node;\n\n  // Ignore products whose inventory isn't tracked\n  if (!variant.inventoryItem?.tracked) {\n    continue;\n  }\n\n  const inventoryLevels =\n    variant.inventoryItem.inventoryLevels?.edges || [];\n\n  for (const levelEdge of inventoryLevels) {\n    const level = levelEdge.node;\n\n    const quantities = {};\n\n    for (const q of level.quantities || []) {\n      quantities[q.name] = q.quantity;\n    }\n\n    results.push({\n      json: {\n        product_id: variant.product.id,\n        product_name: variant.product.title,\n        variant_id: variant.id,\n        variant_title: variant.title,\n        sku: variant.sku || \"\",\n        inventory_item_id: variant.inventoryItem.id,\n\n        location_id: level.location.id,\n        location_name: level.location.name,\n\n        available_stock: quantities.available ?? 0,\n        on_hand_stock: quantities.on_hand ?? 0,\n        committed_stock: quantities.committed ?? 0,\n        incoming_stock: quantities.incoming ?? 0,\n\n        tracked: variant.inventoryItem.tracked\n      }\n    });\n  }\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        784,
        16
      ],
      "id": "5861c301-64ae-4e9e-bd47-ba1515cf13af",
      "name": "Prepare Inventory Data"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const stock = Number($json.available_stock ?? 0);\n\nlet inventory_status;\nlet urgency;\nlet action;\n\nif (stock === 0) {\n  inventory_status = \"Critical\";\n  urgency = \"High\";\n  action = \"Reorder immediately\";\n} else if (stock <= 5) {\n  inventory_status = \"Low\";\n  urgency = \"Medium\";\n  action = \"Reorder soon\";\n} else {\n  inventory_status = \"Normal\";\n  urgency = \"None\";\n  action = \"No action required\";\n}\n\nreturn {\n  json: {\n    ...$json,\n\n    inventory_status,\n    urgency,\n    action,\n\n    checked_at: new Date().toISOString()\n  }\n};"
      },
