      "id": "a5dfefac-d546-4dd8-aada-b03c580b8d3c",
      "name": "Shopify Refund Trigger",
      "webhookId": "<WEBHOOKID> "
    },
    {
      "parameters": {
        "jsCode": "return items.flatMap(item => {\n  const refund = item.json;\n\n  return (refund.refund_line_items || []).map(refundItem => {\n    const lineItem = refundItem.line_item || {};\n    const transaction = (refund.transactions || [])[0] || {};\n\n    return {\n      json: {\n        refund_id: refund.id,\n        order_id: refund.order_id,\n\n        refund_date: refund.created_at,\n\n        refund_amount: Number(transaction.amount || refundItem.subtotal || 0),\n        currency: transaction.currency || 'USD',\n        refund_status: transaction.status || 'unknown',\n\n        restock: refund.restock === true,\n        restock_type: refundItem.restock_type || null,\n\n        product_id: lineItem.product_id || null,\n        product_title: lineItem.title || null,\n        variant_id: lineItem.variant_id || null,\n        variant_title: lineItem.variant_title || null,\n\n        sku: lineItem.sku || null,\n        quantity_refunded: refundItem.quantity || 0,\n\n        location_id: refundItem.location_id || null\n      }\n    };\n  });\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        128,
        0
      ],
      "id": "4eed45f4-24a0-499b-bc75-96bcff6f2fc8",
      "name": "Prepare Refund Data"
    },
    {
      "parameters": {
        "jsCode": "const data = $json;\n\nconst refundType = data.restock\n  ? 'Refund + Restock'\n  : 'Refund Only';\n\nconst message = `*SHOPIFY REFUND ALERT*\n\n*Refund Details*\n━━━━━━━━━━━━━━━━━━━━\n\n• Refund ID: ${data.refund_id}\n• Order ID: ${data.order_id}\n• Refund Date: ${data.refund_date}\n\n*Product Information*\n━━━━━━━━━━━━━━━━━━━━\n\n• Product: ${data.product_title}\n• Variant: ${data.variant_title || 'Default'}\n• SKU: ${data.sku || 'N/A'}\n• Quantity Refunded: ${data.quantity_refunded}\n\n*Financial Details*\n━━━━━━━━━━━━━━━━━━━━\n\n• Refund Amount: ${data.refund_amount.toFixed(2)} ${data.currency}\n• Refund Status: ${data.refund_status}\n\n*Inventory Action*\n━━━━━━━━━━━━━━━━━━━━\n\n• Action: ${refundType}\n• Restock Type: ${data.restock_type || 'N/A'}\n\nPlease review this refund and verify the inventory adjustment if required.`;\n\nreturn [\n  {\n    json: {\n      ...data,\n      refund_type: refundType,\n      slack_message: message\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        352,
        0
      ],
      "id": "71c05f96-1534-4203-910a-7d8d556073d1",
