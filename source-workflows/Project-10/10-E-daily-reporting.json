    {
      "parameters": {
        "jsCode": "const orders = $input.all();\n\nconst totalOrders = orders.length;\n\nconst totalSales = orders.reduce((sum, item) => {\n  return sum + Number(item.json.total_price || 0);\n}, 0);\n\nconst averageOrderValue = totalOrders > 0\n  ? totalSales / totalOrders\n  : 0;\n\nconst paidOrders = orders.filter(item =>\n  item.json.financial_status === 'paid'\n).length;\n\nconst cancelledOrders = orders.filter(item =>\n  item.json.cancelled_at !== null &&\n  item.json.cancelled_at !== undefined\n).length;\n\nconst refundedOrders = orders.filter(item =>\n  item.json.financial_status === 'refunded'\n).length;\n\nreturn [\n  {\n    json: {\n      reportDate: new Date().toISOString().split('T')[0],\n      totalOrders,\n      totalSales: Number(totalSales.toFixed(2)),\n      averageOrderValue: Number(averageOrderValue.toFixed(2)),\n      paidOrders,\n      cancelledOrders,\n      refundedOrders\n    }\n  }\n];"
      },
