      "name": "Merge Inventory Results"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nlet critical = 0;\nlet low = 0;\nlet notTracked = 0;\nlet totalActionable = items.length;\nlet totalStock = 0;\n\nfor (const item of items) {\n  const data = item.json;\n\n  totalStock += Number(data.inventory_quantity || 0);\n\n  if (data.inventory_status === 'CRITICAL') {\n    critical++;\n  } else if (data.inventory_status === 'LOW') {\n    low++;\n  } else if (data.inventory_status === 'NOT TRACKED') {\n    notTracked++;\n  }\n}\n\nreturn [\n  {\n    json: {\n      report_date: new Date().toISOString().split('T')[0],\n      total_actionable_items: totalActionable,\n      critical_items: critical,\n      low_items: low,\n      not_tracked_items: notTracked,\n      actionable_stock_units: totalStock\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2064,
        -304
      ],
      "id": "414d187d-ef85-4852-bfb6-76764ced5a61",
      "name": "Build Inventory Summary"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\nconst reportDate = item.report_date;\nconst totalActionable = item.total_actionable_items;\nconst critical = item.critical_items;\nconst low = item.low_items;\nconst notTracked = item.not_tracked_items;\nconst actionableUnits = item.actionable_stock_units;\n\nlet priority = 'NORMAL';\n\nif (critical > 0) {\n  priority = 'HIGH';\n} else if (low > 0 || notTracked > 0) {\n  priority = 'MEDIUM';\n}\n\nconst slack_message = `📦 *SHOPIFY INVENTORY MONITORING REPORT*\n\n*Report Date:* ${reportDate}\n\n━━━━━━━━━━━━━━━━━━━━\n\n🚨 *INVENTORY REQUIRING ATTENTION*\n\n• Critical Stock: *${critical} items*\n• Low Stock: *${low} items*\n• Not Tracked: *${notTracked} items*\n\n*Total Actionable Items:* ${totalActionable}\n\n━━━━━━━━━━━━━━━━━━━━\n\n📊 *STOCK OVERVIEW*\n\n• Available Units: *${actionableUnits}*\n• Reorder Priority: *${priority}*\n\n━━━━━━━━━━━━━━━━━━━━\n\n🔧 *RECOMMENDED ACTION*\n\nPlease review the critical and low-stock items and initiate replenishment where required.\n\nNot Tracked items should be reviewed to ensure inventory monitoring is properly configured.`;\n\nreturn [\n  {\n    json: {\n      report_date: reportDate,\n      total_actionable_items: totalActionable,\n      critical_items: critical,\n      low_items: low,\n      not_tracked_items: notTracked,\n      actionable_stock_units: actionableUnits,\n      reorder_priority: priority,\n      slack_message: slack_message\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
