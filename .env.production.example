# AI E-Commerce Operations Platform
# Production environment template
# Copy to .env on the production server and replace every placeholder.

# Application
APP_NAME=AI E-commerce Operations Platform
APP_ENV=production
APP_DEBUG=false

# PostgreSQL
POSTGRES_DB=ecommerce_platform
POSTGRES_USER=ecommerce_app
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DATABASE_PASSWORD
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000

# Frontend
VITE_API_BASE_URL=/api/v1
VITE_API_KEY=REPLACE_WITH_STRONG_API_KEY

# Application Security
API_SECRET_KEY=REPLACE_WITH_STRONG_API_KEY